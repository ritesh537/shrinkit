# API Endpoint (for image compression only)
# Get this from: terraform -chdir=terraform/api-gateway output api_endpoint
REACT_APP_API_ENDPOINT=https://your-api-gateway-url

# reCAPTCHA v3 Site Key (for bot protection on compress endpoint)
# Get from: https://www.google.com/recaptcha/admin
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
